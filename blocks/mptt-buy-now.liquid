
{%- liquid
  assign buy_product = block.settings.product
  if buy_product == blank
    assign buy_product = product
  endif
  assign can_show = false
  if buy_product != blank and buy_product.variants.size <= 1
    assign can_show = true
  endif
-%}

{%- if can_show -%}
  {%- style -%}
    #block-{{ block.id }} .mptt-buy-button {
      background-color: {{ block.settings.bg_color }};
      color: {{ block.settings.text_color }};
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      margin-top: {{ block.settings.margin_top }}px;

      &:hover {
        background-color: {{ block.settings.bg_color_hover }} !important;
        color: {{ block.settings.text_color_hover }} !important;
      }
    }
  {%- endstyle -%}

  <div id="block-{{ block.id }}" class="mptt-block mptt-block--buy-now" {{ block.shopify_attributes }}>
    {%- liquid
      assign button_text = block.settings.text
      assign parts = button_text | split: '*'
    -%}
    <a href="{{ routes.cart_add_url }}?id={{ buy_product.selected_or_first_available_variant.id }}&quantity=1" 
      class="mptt-buy-button" 
      aria-label="{{ 'products.product.add_to_cart' | t }}"
    >
      <span class="mptt-buy-button__text">
        {%- for part in parts -%}
          {%- if forloop.index == 2 -%}
            <span class="mptt-buy-button__highlight">{{ part }}</span>
          {%- else -%}
            {{ part }}
          {%- endif -%}
        {%- endfor -%}
      </span>
      {%- if block.settings.icon != 'none' -%}
        <span class="mptt-buy-button__icon">
          {% render 'icon', icon: block.settings.icon %}
        </span>
      {%- endif -%}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Buy Now Button",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "text", "label": "Button Text", "default": "*Buy Now - *$25" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "icon", "label": "Icon Name", "default": "arrow" },
    { "type": "header", "content": "General" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0F2918" },
    { "type": "color", "id": "bg_color_hover", "label": "Hover Background Color", "default": "#1a4a2a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color_hover", "label": "Hover Text Color", "default": "#ffffff" },
    { "type": "header", "content": "Spacings" },
    { "type": "range", "id": "padding_vertical", "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Padding Top/Bottom", "default": 16 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "Padding Left/Right", "default": 16 },
    { "type": "range", "id": "margin_top", "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Margin Top", "default": 40 }
  ],
  "presets": [
    { "name": "Buy Now Button" }
  ]
}
{% endschema %}
