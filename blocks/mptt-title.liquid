
{%- style -%}
  #block-{{ block.id }} .mptt-title {
    font-size: {{ block.settings.font_size_desktop }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.color }};
    margin-top: {{ block.settings.margin_top_desktop }}px;

    @media screen and (max-width: 767px) {
      & {
        margin-top: {{ block.settings.margin_top_mobile }}px;
        font-size: {{ block.settings.font_size_mobile }}px;
      }
    }
  }
{%- endstyle -%}

<div id="block-{{ block.id }}" class="mptt-block mptt-block--title" {{ block.shopify_attributes }}>
  <h1 class="mptt-title">
    {{ product.title }}
  </h1>
</div>

{% schema %}
{
  "name": "Title",
  "settings": [
    { "type": "range", "id": "font_size_desktop", "min": 10, "max": 100, "step": 1, "unit": "px", "label": "Font Size (Desktop)", "default": 32 },
    { "type": "range", "id": "font_size_mobile", "min": 10, "max": 100, "step": 1, "unit": "px", "label": "Font Size (Mobile)", "default": 24 },
    { "type": "select", "id": "font_weight", "label": "Font Weight", "options": [
      { "value": "400", "label": "Normal" },
      { "value": "700", "label": "Bold" }
    ], "default": "700" },
    { "type": "color", "id": "color", "label": "Color", "default": "#000000" },
    { "type": "range", "id": "margin_top_desktop", "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Margin Top (Desktop)", "default": 20 },
    { "type": "range", "id": "margin_top_mobile", "min": 0, "max": 50, "step": 1, "unit": "px", "label": "Margin Top (Mobile)", "default": 15 }
  ],
  "presets": [
    { "name": "Title" }
  ]
}
{% endschema %}
