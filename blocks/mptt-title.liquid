{%- style -%}
  #shopify-block-{{ block.id }} {
    margin-top: {{ block.settings.margin_top_desktop }}px;
    max-width: {{ block.settings.max_width_desktop }}px;

    @media screen and (max-width: {{ block.settings.breakpoint }}px) {
      & {
        margin-top: {{ block.settings.margin_top_mobile }}px;
        max-width: {{ block.settings.max_width_mobile }}px;
      }
    }
  }

  #shopify-block-{{ block.id }} .mptt-title {
    font-size: {{ block.settings.font_size_desktop }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.color }};
    margin: 0;

    @media screen and (max-width: {{ block.settings.breakpoint }}px) {
      & {
        font-size: {{ block.settings.font_size_mobile }}px;
      }
    }
  }
{%- endstyle -%}

{%- if product.title != blank -%}
  <{{ block.settings.heading_tag }}
    class="mptt-title"
    {{ block.shopify_attributes }}
  >
    <span class="visually-hidden">Product title: </span>
    {{ product.title }}
  </{{ block.settings.heading_tag }}>
{%- endif -%}

{% schema %}
{
  "name": "Title",
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Mobile)",
      "default": 32
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "100", "label": "100 - Thin" },
        { "value": "200", "label": "200 - Extra Light" },
        { "value": "300", "label": "300 - Light" },
        { "value": "400", "label": "400 - Normal" },
        { "value": "500", "label": "500 - Medium" },
        { "value": "600", "label": "600 - Semi Bold" },
        { "value": "700", "label": "700 - Bold" },
        { "value": "800", "label": "800 - Extra Bold" },
        { "value": "900", "label": "900 - Boldest" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color", "label": "Color", "default": "#0F2918" },
    { "type": "header", "content": "Spacings" },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 12
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "max_width_desktop",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Max-width (desktop)",
      "default": 1200
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Max-width (mobile)",
      "default": 800
    },
    { "type": "number", "id": "breakpoint", "label": "Responsive Breakpoint (max-width)", "default": 767 }
  ],
  "presets": [{ "name": "Title" }]
}
{% endschema %}
